# Chainlink Bootcamp Environment Configuration
# Copy this file to .env and fill in your values

# ========== RPC URLs ==========
# Ethereum Sepolia
ETH_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Avalanche Fuji
AVAX_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Base Sepolia
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ========== Private Keys ==========
# For testing and deployment (NEVER commit private keys!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ========== Chainlink Addresses ==========
# Ethereum Sepolia
ETH_SEPOLIA_LINK_TOKEN=0x779877A7B0D9E8603169DdbD7836e478b4624789
